{
	"schemaVersion": 1,
	"id": "iceboat-plugin",
	"version": "${version}",
	"name": "Iceboat Plugin",
	"description": "A mod for tracking ice boat races; Created for UNSW MCSoc.",
	"authors": [
		"veveddo"
	],
	"contact": {
		"homepage": "https://unswminecraft.com",
		"sources": "https://github.com/UNSW-Minecraft-Society/iceboat-plugin-26.3"
	},
	"license": "CC0-1.0",
	"icon": "assets/iceboat-plugin/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			{
				"value": "mcsoc.iceboat.IceboatPlugin",
				"adapter": "kotlin"
			}
		],
		"client": [
			{
				"value": "mcsoc.iceboat.client.IceboatPluginClient",
				"adapter": "kotlin"
			}
		],
		"fabric-datagen": [
			{
				"value": "mcsoc.iceboat.client.IceboatPluginDataGenerator",
				"adapter": "kotlin"
			}
		]
	},
	"mixins": [
		"iceboat-plugin.mixins.json",
		{
			"config": "iceboat-plugin.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3-",
		"java": ">=25",
		"fabric-api": "*",
		"fabric-language-kotlin": "*"
	}
}